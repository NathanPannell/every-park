{
  "name": "every-park",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-vercel-static.mjs",
    "db:create": "node database/scripts/create-database.mjs",
    "db:migrate": "node database/scripts/migrate.mjs",
    "db:load": "node database/scripts/load-data.mjs",
    "db:validate": "node database/scripts/validate.mjs",
    "db:setup": "npm run db:migrate && npm run db:load",
    "db:up": "docker compose -f database/docker-compose.yml up -d",
    "db:down": "docker compose -f database/docker-compose.yml down"
  },
  "dependencies": {
    "pg": "8.16.3"
  }
}

